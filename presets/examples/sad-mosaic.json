{
  "format": "glic-studio-preset",
  "version": 1,
  "name": "sad mosaic",
  "description": "SAD picks a predictor per block; coarse blocks and strong quantization",
  "encode": {
    "colorspace": "HWB",
    "border": [
      128,
      128,
      128
    ],
    "seed": 0,
    "channels": [
      {
        "min_block": 8,
        "max_block": 256,
        "threshold": 15,
        "prediction": "SAD",
        "quantization": 110,
        "clamp": "none",
        "wavelet": "NONE",
        "transform": "FWT",
        "compression": 0,
        "scale": 1048576,
        "encoding": "PACKED"
      }
    ]
  },
  "decode": {
    "linked": true
  }
}
