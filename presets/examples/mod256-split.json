{
  "format": "glic-studio-preset",
  "version": 1,
  "name": "mod256 split",
  "description": "Per-channel: mod-256 wrap on one channel, ANGLE on another, Coiflet on the third",
  "encode": {
    "colorspace": "RGB",
    "border": [
      128,
      128,
      128
    ],
    "seed": 0,
    "channels": [
      {
        "min_block": 4,
        "max_block": 256,
        "threshold": 15,
        "prediction": "PAETH",
        "quantization": 120,
        "clamp": "mod256",
        "wavelet": "NONE",
        "transform": "FWT",
        "compression": 0,
        "scale": 1048576,
        "encoding": "PACKED"
      },
      {
        "min_block": 4,
        "max_block": 256,
        "threshold": 15,
        "prediction": "ANGLE",
        "quantization": 30,
        "clamp": "none",
        "wavelet": "NONE",
        "transform": "FWT",
        "compression": 0,
        "scale": 1048576,
        "encoding": "PACKED"
      },
      {
        "min_block": 4,
        "max_block": 256,
        "threshold": 15,
        "prediction": "AVG",
        "quantization": 20,
        "clamp": "none",
        "wavelet": "Coiflet 2",
        "transform": "FWT",
        "compression": 0,
        "scale": 1048576,
        "encoding": "PACKED"
      }
    ]
  },
  "decode": {
    "linked": true
  }
}
